model StudentProfile {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  studentId          String   @unique @map("student_id") @db.VarChar(50)
  department         String   @db.VarChar(100)
  program            String?  @db.VarChar(100)
  batch              String?  @db.VarChar(30)
  semester           String?  @db.VarChar(30)
  bio                String?  @db.Text
  skills             String?
  portfolioUrl       String?  @map("portfolio_url") @db.Text
  linkedinUrl        String?  @map("linkedin_url") @db.Text
  verificationStatus String   @default("PENDING") @map("verification_status") @db.VarChar(20)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user               User     @relation("StudentProfile_UserId", fields: [userId], references: [id], onDelete: Cascade)

  @@map("student_profiles")
}
