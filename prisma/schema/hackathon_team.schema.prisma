model HackathonTeam {
  id                   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId              String                @map("event_id") @db.Uuid
  name                 String                @db.VarChar(150)
  teamLeadId           String                @map("team_lead_id") @db.Uuid
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  event                Event                 @relation("HackathonTeam_EventId", fields: [eventId], references: [id], onDelete: Cascade)
  user                 User                  @relation("HackathonTeam_TeamLeadId", fields: [teamLeadId], references: [id])
  hackathonTeamMembers HackathonTeamMember[] @relation("HackathonTeamMember_TeamId")
  hackathonSubmissions HackathonSubmission[] @relation("HackathonSubmission_TeamId")

  @@unique([eventId, name])
  @@map("hackathon_teams")
}
