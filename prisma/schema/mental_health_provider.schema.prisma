model MentalHealthProvider {
  id                       String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                   String?                   @unique @map("user_id") @db.Uuid
  name                     String                    @db.VarChar(150)
  designation              String?                   @db.VarChar(100)
  bio                      String?                   @db.Text
  contactEmail             String?                   @map("contact_email") @db.VarChar(255)
  isActive                 Boolean                   @default(true) @map("is_active")
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  user                     User?                     @relation("MentalHealthProvider_UserId", fields: [userId], references: [id], onDelete: SetNull)
  mentalHealthAppointments MentalHealthAppointment[] @relation("MentalHealthAppointment_ProviderId")

  @@map("mental_health_providers")
}
