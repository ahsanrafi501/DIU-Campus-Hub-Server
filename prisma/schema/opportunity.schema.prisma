model Opportunity {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy               String                   @map("created_by") @db.Uuid
  organizationId          String?                  @map("organization_id") @db.Uuid
  title                   String                   @db.VarChar(200)
  description             String                   @db.Text
  opportunityType         String                   @map("opportunity_type") @db.VarChar(30)
  provider                String?                  @db.VarChar(150)
  eligibility             String?                  @db.Text
  applicationUrl          String?                  @map("application_url") @db.Text
  deadline                DateTime?                @db.Timestamptz(6)
  isPublished             Boolean                  @default(false) @map("is_published")
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  user                    User                     @relation("Opportunity_CreatedBy", fields: [createdBy], references: [id])
  organization            Organization?            @relation("Opportunity_OrganizationId", fields: [organizationId], references: [id], onDelete: SetNull)
  opportunityApplications OpportunityApplication[] @relation("OpportunityApplication_OpportunityId")

  @@index([isPublished, deadline])
  @@map("opportunities")
}
