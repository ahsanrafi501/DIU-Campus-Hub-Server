model User {
  id                                  String                    @id @default(uuid())
  name                                String                    @db.VarChar(100)
  email                               String                    @unique @db.VarChar(255)
  password                            String?                   @db.VarChar(255)
  phone                               String?                   @db.VarChar(20)
  profileImage                        String?                   @map("profile_image") @db.Text
  googleId                            String?                   @unique @map("google_id") @db.VarChar(255)
  role                                UserRole                  @default(STUDENT) @map("user_roles")
  isVerified                          Boolean                   @default(false) @map("is_verified")
  isActive                            Boolean                   @default(true) @map("is_active")
  createdAt                           DateTime                  @default(now()) @map("created_at")
  updatedAt                           DateTime                  @updatedAt @map("updated_at") 
  studentProfiles                     StudentProfile[]          @relation("StudentProfile_UserId")
  organizationMembers                 OrganizationMember[]      @relation("OrganizationMember_UserId")
  events                              Event[]                   @relation("Event_CreatedBy")
  eventRegistrations                  EventRegistration[]       @relation("EventRegistration_UserId")
  clubMemberships                     ClubMembership[]          @relation("ClubMembership_UserId")
  opportunities                       Opportunity[]             @relation("Opportunity_CreatedBy")
  opportunityApplications             OpportunityApplication[]  @relation("OpportunityApplication_UserId")
  hackathonTeams                      HackathonTeam[]           @relation("HackathonTeam_TeamLeadId")
  hackathonTeamMembers                HackathonTeamMember[]     @relation("HackathonTeamMember_UserId")
  hackathonSubmissions                HackathonSubmission[]     @relation("HackathonSubmission_SubmittedBy")
  hackathonJudges                     HackathonJudge[]          @relation("HackathonJudge_UserId")
  newsArticles                        NewsArticle[]             @relation("NewsArticle_AuthorId")
  achievementNominationsByNominatedBy AchievementNomination[]   @relation("AchievementNomination_NominatedBy")
  achievementNominationsByStudentId   AchievementNomination[]   @relation("AchievementNomination_StudentId")
  achievementNominationsByReviewedBy  AchievementNomination[]   @relation("AchievementNomination_ReviewedBy")
  communityPosts                      CommunityPost[]           @relation("CommunityPost_UserId")
  communityComments                   CommunityComment[]        @relation("CommunityComment_UserId")
  moderationReportsByReporterId       ModerationReport[]        @relation("ModerationReport_ReporterId")
  moderationReportsByReviewedBy       ModerationReport[]        @relation("ModerationReport_ReviewedBy")
  welfareResources                    WelfareResource[]         @relation("WelfareResource_CreatedBy")
  welfareCasesByStudentId             WelfareCase[]             @relation("WelfareCase_StudentId")
  welfareCasesByAssignedTo            WelfareCase[]             @relation("WelfareCase_AssignedTo")
  welfareCaseUpdates                  WelfareCaseUpdate[]       @relation("WelfareCaseUpdate_UpdatedBy")
  mentalHealthProviders               MentalHealthProvider[]    @relation("MentalHealthProvider_UserId")
  mentalHealthAppointments            MentalHealthAppointment[] @relation("MentalHealthAppointment_StudentId")
  notifications                       Notification[]            @relation("Notification_UserId")
  notificationPreferences             NotificationPreference[]  @relation("NotificationPreference_UserId")
  auditLogs                           AuditLog[]                @relation("AuditLog_ActorId")

  @@map("users")
}
