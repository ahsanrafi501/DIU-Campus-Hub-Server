model EventRegistration {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  status       String   @default("REGISTERED") @db.VarChar(20)
  registeredAt DateTime @default(now()) @map("registered_at") @db.Timestamptz(6)
  event        Event    @relation("EventRegistration_EventId", fields: [eventId], references: [id], onDelete: Cascade)
  user         User     @relation("EventRegistration_UserId", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_registrations")
}
