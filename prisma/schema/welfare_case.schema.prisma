model WelfareCase {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId          String              @map("student_id") @db.Uuid
  assignedTo         String?             @map("assigned_to") @db.Uuid
  category           String              @db.VarChar(30)
  subject            String              @db.VarChar(200)
  description        String              @db.Text
  priority           String              @default("NORMAL") @db.VarChar(20)
  status             String              @default("OPEN") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @map("updated_at") @db.Timestamptz(6)
  userByStudentId    User                @relation("WelfareCase_StudentId", fields: [studentId], references: [id])
  userByAssignedTo   User?               @relation("WelfareCase_AssignedTo", fields: [assignedTo], references: [id])
  welfareCaseUpdates WelfareCaseUpdate[] @relation("WelfareCaseUpdate_CaseId")

  @@index([studentId, status])
  @@map("welfare_cases")
}
