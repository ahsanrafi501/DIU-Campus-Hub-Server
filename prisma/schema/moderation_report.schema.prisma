model ModerationReport {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId       String            @map("reporter_id") @db.Uuid
  postId           String?           @map("post_id") @db.Uuid
  commentId        String?           @map("comment_id") @db.Uuid
  reason           String            @db.VarChar(100)
  details          String?           @db.Text
  status           String            @default("PENDING") @db.VarChar(20)
  reviewedBy       String?           @map("reviewed_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  userByReporterId User              @relation("ModerationReport_ReporterId", fields: [reporterId], references: [id])
  communityPost    CommunityPost?    @relation("ModerationReport_PostId", fields: [postId], references: [id], onDelete: Cascade)
  communityComment CommunityComment? @relation("ModerationReport_CommentId", fields: [commentId], references: [id], onDelete: Cascade)
  userByReviewedBy User?             @relation("ModerationReport_ReviewedBy", fields: [reviewedBy], references: [id])

  @@map("moderation_reports")
}
