model HackathonSubmission {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId           String            @unique @map("team_id") @db.Uuid
  submittedBy      String            @map("submitted_by") @db.Uuid
  title            String            @db.VarChar(200)
  description      String?           @db.Text
  repositoryUrl    String?           @map("repository_url") @db.Text
  demoUrl          String?           @map("demo_url") @db.Text
  documentUrl      String?           @map("document_url") @db.Text
  status           String            @default("SUBMITTED") @db.VarChar(20)
  submittedAt      DateTime?         @map("submitted_at") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  hackathonTeam    HackathonTeam     @relation("HackathonSubmission_TeamId", fields: [teamId], references: [id], onDelete: Cascade)
  user             User              @relation("HackathonSubmission_SubmittedBy", fields: [submittedBy], references: [id])
  submissionScores SubmissionScore[] @relation("SubmissionScore_SubmissionId")

  @@map("hackathon_submissions")
}
