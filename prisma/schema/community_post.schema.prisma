model CommunityPost {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  content           String             @db.Text
  mediaUrl          String?            @map("media_url") @db.Text
  postType          String             @default("GENERAL") @map("post_type") @db.VarChar(20)
  status            String             @default("PUBLISHED") @db.VarChar(20)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(now()) @map("updated_at") @db.Timestamptz(6)
  user              User               @relation("CommunityPost_UserId", fields: [userId], references: [id], onDelete: Cascade)
  communityComments CommunityComment[] @relation("CommunityComment_PostId")
  moderationReports ModerationReport[] @relation("ModerationReport_PostId")

  @@index([createdAt])
  @@map("community_posts")
}
