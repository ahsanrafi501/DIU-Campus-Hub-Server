model AchievementNomination {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nominatedBy       String   @map("nominated_by") @db.Uuid
  studentId         String   @map("student_id") @db.Uuid
  title             String   @db.VarChar(200)
  description       String   @db.Text
  evidenceUrl       String?  @map("evidence_url") @db.Text
  status            String   @default("PENDING") @db.VarChar(20)
  reviewedBy        String?  @map("reviewed_by") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  userByNominatedBy User     @relation("AchievementNomination_NominatedBy", fields: [nominatedBy], references: [id])
  userByStudentId   User     @relation("AchievementNomination_StudentId", fields: [studentId], references: [id])
  userByReviewedBy  User?    @relation("AchievementNomination_ReviewedBy", fields: [reviewedBy], references: [id])

  @@map("achievement_nominations")
}
