model WelfareCaseUpdate {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId      String      @map("case_id") @db.Uuid
  updatedBy   String      @map("updated_by") @db.Uuid
  message     String      @db.Text
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  welfareCase WelfareCase @relation("WelfareCaseUpdate_CaseId", fields: [caseId], references: [id], onDelete: Cascade)
  user        User        @relation("WelfareCaseUpdate_UpdatedBy", fields: [updatedBy], references: [id])

  @@map("welfare_case_updates")
}
