model WelfareResource {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy      String   @map("created_by") @db.Uuid
  title          String   @db.VarChar(200)
  description    String   @db.Text
  resourceType   String   @map("resource_type") @db.VarChar(30)
  contactInfo    String?  @map("contact_info") @db.Text
  applicationUrl String?  @map("application_url") @db.Text
  isPublished    Boolean  @default(false) @map("is_published")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation("WelfareResource_CreatedBy", fields: [createdBy], references: [id])

  @@map("welfare_resources")
}
