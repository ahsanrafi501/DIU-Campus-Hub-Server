model OpportunityApplication {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  opportunityId     String      @map("opportunity_id") @db.Uuid
  userId            String      @map("user_id") @db.Uuid
  applicationStatus String      @default("SAVED") @map("application_status") @db.VarChar(20)
  notes             String?     @db.Text
  appliedAt         DateTime?   @map("applied_at") @db.Timestamptz(6)
  createdAt         DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  opportunitie      Opportunity @relation("OpportunityApplication_OpportunityId", fields: [opportunityId], references: [id], onDelete: Cascade)
  user              User        @relation("OpportunityApplication_UserId", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, userId])
  @@index([userId])
  @@map("opportunity_applications")
}
