model HackathonTeamMember {
  teamId        String        @map("team_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  status        String        @default("ACTIVE") @db.VarChar(20)
  joinedAt      DateTime      @default(now()) @map("joined_at") @db.Timestamptz(6)
  hackathonTeam HackathonTeam @relation("HackathonTeamMember_TeamId", fields: [teamId], references: [id], onDelete: Cascade)
  user          User          @relation("HackathonTeamMember_UserId", fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
  @@map("hackathon_team_members")
}
