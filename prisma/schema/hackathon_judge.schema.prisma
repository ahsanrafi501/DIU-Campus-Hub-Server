model HackathonJudge {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId          String            @map("event_id") @db.Uuid
  userId           String            @map("user_id") @db.Uuid
  event            Event             @relation("HackathonJudge_EventId", fields: [eventId], references: [id], onDelete: Cascade)
  user             User              @relation("HackathonJudge_UserId", fields: [userId], references: [id], onDelete: Cascade)
  submissionScores SubmissionScore[] @relation("SubmissionScore_JudgeId")

  @@unique([eventId, userId])
  @@map("hackathon_judges")
}
